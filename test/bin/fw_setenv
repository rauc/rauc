#!/bin/bash

# Use a separate state file for each namespace
if [ "$1" = "-m" ]; then
	UBOOT_STATE_PATH="$UBOOT_STATE_PATH.$2"
	shift 2
fi

# Read env file into environment
eval $(cat $UBOOT_STATE_PATH | sed  "s/\(.*\)=\(.*\)/export \1=\"\2\"/g")
UBOOT_VARS_PRE=$(cat $UBOOT_STATE_PATH | sed  "s/\(.*\)=\(.*\)/\1/g" | tr '\n' ' ')

function check_var {
	found=0
	for l in $UBOOT_VARS_PRE; do
		if [ "$1" = "${l%=*}" ]; then
			found=1
		fi
	done
	if [ "$found" -eq "0" ]; then
		echo "Invalid variable: $1"
		exit 1
	fi
}

# Command line checking
if [ $# -lt 2 ] || [ $(($# % 2)) -ne 0 ]; then
	echo "Invalid arguments $*"
	exit 1
fi

# Set var
while [[ $# -gt 0 ]]
do
	var="$1"
	val="$2"
	shift
	shift

	check_var "$var" "$val"

	# FWU metadata v1 has no bank state to mark a bank invalid
	if [ "$FWU_MDATA_VERSION" = "1" ] && [ "$val" = "invalid" ]; then
		echo "libuboot_set_env failed: -95"
		exit 95
	fi

	# Assign new value
	echo "setting: $var to $val"
	eval "${var}=\"${val}\""
done

# write back
rm $UBOOT_STATE_PATH
for l in $UBOOT_VARS_PRE; do
	echo "${l}=${!l}"
	echo "${l}=${!l}" >> $UBOOT_STATE_PATH
done

exit 0
